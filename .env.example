# CollabSpace server configuration (cmd/server). Copy to .env for local
# development and never commit the copy. Every variable is read from the
# environment; the server refuses to start if a required one is missing.

# Required. PostgreSQL connection string. In production, put credentials in
# a secret store, not in this file: set DATABASE_URL_FILE to a file holding
# the URL instead (e.g. a container secret, /run/secrets/database_url).
# Setting both is refused.
DATABASE_URL=postgres:///collabspace_dev?host=/tmp
# DATABASE_URL_FILE=

# Containers: the Docker deployment is configured in deploy/env.example and
# deploy/compose.yaml, not here (see docs/operations.md, Part 2).

# Required. Exact browser origins allowed to call the API and open
# WebSockets (comma-separated, scheme://host[:port], no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session cookie "Secure" flag. Defaults to true. Set false ONLY for local
# development over plain http://; never in production. The server refuses to
# start with false unless every ALLOWED_ORIGINS entry is http://localhost,
# 127.0.0.1 or [::1].
COOKIE_SECURE=false

# Login/registration rate limits, "N/duration" or "off" (defaults shown).
# In-memory and per process: with several instances, each enforces its own.
# RATE_LIMIT_LOGIN_PER_IP=30/10m
# RATE_LIMIT_LOGIN_PER_ACCOUNT_IP=10/10m  # one account from one address
# RATE_LIMIT_LOGIN_PER_ACCOUNT=50/10m     # one account from all addresses together
# RATE_LIMIT_REGISTER_PER_IP=10/1h
# RATE_LIMIT_SHARE_PER_USER=30/10m        # sharing reveals whether an email is registered
# Leave empty unless a reverse proxy you control OVERWRITES this header with
# the client address (e.g. Nginx: proxy_set_header X-Real-IP $remote_addr).
# Otherwise clients could spoof it to dodge the per-IP limits.
# TRUSTED_PROXY_IP_HEADER=

# Optional (defaults shown).
# HTTP_ADDR=127.0.0.1:8080
# SESSION_TTL=168h
# MIGRATE_ON_START=true
# LOG_LEVEL=info          # debug | info | warn | error
# LOG_FORMAT=json         # json | text
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=30s  # must exceed the slowest handler (password hashing)
# HTTP_IDLE_TIMEOUT=120s
# SHUTDOWN_TIMEOUT=15s
# STATS_LOG_INTERVAL=5m   # how often to log collaboration counts (rooms, connections, evictions…)
