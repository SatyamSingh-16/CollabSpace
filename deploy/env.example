# Copy to deploy/.env (git-ignored, docker-ignored) and edit. No secrets go
# here: the database password and URL are files in deploy/secrets/ created
# by deploy/gen-secrets.sh.

# The exact origin browsers use. The app accepts API calls and WebSockets
# only from it, and session cookies are Secure (HTTPS only).
PUBLIC_ORIGIN=https://localhost:8443

# Local: Nginx on 127.0.0.1:8080 (redirects) and :8443 (HTTPS).
BIND_ADDR=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
# Redirects go to https://<host><suffix>; ":8443" locally, empty for 443.
PUBLIC_HTTPS_PORT_SUFFIX=:8443
SERVER_NAME=localhost
# Directory with fullchain.pem and privkey.pem (mounted read-only).
TLS_DIR=./secrets/tls
# Where certbot --webroot writes HTTP-01 challenge files (served on port 80).
ACME_WEBROOT=./acme
# Only with a real, publicly trusted certificate, e.g. 31536000 (1 year).
HSTS_MAX_AGE=

# Production example (a real domain, certificate from Let's Encrypt):
# PUBLIC_ORIGIN=https://collab.example.com
# BIND_ADDR=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443
# PUBLIC_HTTPS_PORT_SUFFIX=
# SERVER_NAME=collab.example.com
# Written by deploy/certbot-deploy-hook.sh. NOT /etc/letsencrypt/live/<domain>:
# its files are symlinks that dangle when mounted, and the key is root-only.
# TLS_DIR=/etc/collabspace/tls
# ACME_WEBROOT=/opt/collabspace/deploy/acme
# Only after HTTPS and certificate renewal are verified (docs/deployment.md):
# HSTS_MAX_AGE=31536000
