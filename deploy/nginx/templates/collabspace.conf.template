# Rendered at container start by the image's envsubst step. Only variables
# set in the container's environment are replaced (SERVER_NAME,
# PUBLIC_HTTPS_PORT_SUFFIX, HSTS_MAX_AGE); Nginx's own $variables are kept.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Strict-Transport-Security only when HSTS_MAX_AGE is set.
map "${HSTS_MAX_AGE}" $hsts {
    ""      "";
    default "max-age=${HSTS_MAX_AGE}; includeSubDomains";
}

# Coarse per-address limit on the endpoints that hash passwords, in front of
# the application's own limits (defense in depth, not a replacement).
limit_req_zone $binary_remote_addr zone=auth:10m rate=${AUTH_RATE_LIMIT};
limit_req_status 429;

# Docker's DNS, re-resolved, so a recreated app container (new IP) is found.
resolver 127.0.0.11 valid=10s ipv6=off;
upstream app {
    zone app 64k;
    server app:8080 resolve;
    keepalive 16;
}

# Plain HTTP: ACME challenges (Let's Encrypt) and a redirect to HTTPS.
server {
    listen 8080;
    listen [::]:8080;
    server_name ${SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }
    # The configured name, not the client's Host header: a forged Host must
    # not choose where the redirect points.
    location / {
        return 308 https://${SERVER_NAME}${PUBLIC_HTTPS_PORT_SUFFIX}$request_uri;
    }
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    # Mounted at runtime, never baked into the image.
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # The API accepts JSON bodies up to 64 KiB (httpx.MaxJSONBody); reject
    # bigger ones here. WebSocket frames are not affected (the app's own
    # limit is 1 MiB per frame).
    client_max_body_size 64k;
    root /usr/share/nginx/html;

    location /api/ {
        # No compression of API responses over TLS: compressing secrets
        # together with attacker-influenced input is the BREACH pattern.
        gzip off;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://app;
    }

    location ~ ^/api/auth/(login|register)$ {
        limit_req zone=auth burst=10 nodelay;
        gzip off;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://app;
    }

    # WebSocket: HTTP/1.1 upgrade, and timeouts longer than the app's
    # heartbeat (ping every 25 s, read deadline 60 s), so an idle but healthy
    # connection is never cut by the proxy.
    location /ws/ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;
        proxy_pass http://app;
    }

    # Health endpoints are for the container runtime, not the internet.
    location = /healthz { return 404; }
    location = /readyz  { return 404; }

    # Hashed build assets never change: cache for a year.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The single-page app: every other path is index.html, never cached, so
    # a new release is picked up on the next load.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
